# Copy this file to .env (same folder as app.py) and fill in what you have. Restart app.py after changes.

# HAL-X THX-02 key (starts with sk-). Without it THX-02 uses the free tier: 60 decisions per minute per IP.
HALX_API_KEY=

# THX-02 endpoint (optional). Leave empty for HAL-X's API; set it to your own thx02-serve, e.g.
# http://127.0.0.1:8200/v1/decide (then HALX_API_KEY is the THX_API_KEY you started that server with).
HALX_URL=

# Hugging Face token (optional). Raises the ZeroGPU daily quota for imajev-4b and Jev-Omni.
HF_TOKEN=
